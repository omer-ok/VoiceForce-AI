# The backend reads these values from the repository root .env.local.
# Keep this file as a names-only reference; do not copy secrets here.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit Inference LLM. Keep the Mini values as the safe fallback until the
# controlled Terra/Luna benchmark promotes a candidate.
VOICEFORCE_LLM_MODEL=openai/gpt-5-mini
VOICEFORCE_LLM_REASONING_EFFORT=low
VOICEFORCE_LLM_MAX_COMPLETION_TOKENS=256

# Bounded speculative speech. Set VOICEFORCE_PREEMPTIVE_TTS=false to roll back
# speculative TTS while keeping preemptive LLM generation enabled.
VOICEFORCE_PREEMPTIVE_TTS=true
VOICEFORCE_PREEMPTIVE_TTS_MAX_SPEECH_SECONDS=8.0
VOICEFORCE_PREEMPTIVE_TTS_MAX_RETRIES=2

# Experimental: enable only for controlled fast-result benchmarks.
VOICEFORCE_FAST_PROPERTY_RESULTS=false

# LiveKit Inference Inworld TTS-2 Flash configuration. These are voice IDs,
# not Inworld API keys. Simon is the validated English system voice; Aarav and
# Omar are the selected Urdu and Arabic voices.
VOICEFORCE_INWORLD_MODEL=inworld/inworld-tts-2-flash
VOICEFORCE_INWORLD_ENGLISH_VOICE=Simon
VOICEFORCE_INWORLD_URDU_VOICE=
VOICEFORCE_INWORLD_ARABIC_VOICE=
